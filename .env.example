# Copy this file to .env and fill in your own values.
# .env is git-ignored; never commit real credentials.

# --- PostgreSQL database (required) ---
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=your-db-host.example.com
DB_PORT=5432

# --- Django (required on Vercel; optional locally) ---
# DJANGO_SECRET_KEY=a-long-random-string
# DJANGO_DEBUG=false            # defaults: true locally, false on Vercel

# --- Supabase Storage for profile pictures (required on Vercel) ---
# Supabase > Storage > S3 Connection: enable it and create an access key.
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_STORAGE_BUCKET=avatars
SUPABASE_STORAGE_REGION=ap-northeast-1
SUPABASE_STORAGE_ACCESS_KEY_ID=your-access-key-id
SUPABASE_STORAGE_SECRET_ACCESS_KEY=your-secret-access-key
# SUPABASE_STORAGE_ENDPOINT=   # only if Supabase shows a different S3 endpoint


# --- Live flight status API ---
FLIGHT_API_KEY=your-flight-api-key
# Monthly cap on flight API calls (free plan allows 100)
FLIGHT_API_MONTHLY_LIMIT=90
# Aviationstack's free plan only supports plain HTTP. HTTPS (the default) keeps the key private;
# uncomment this only if you accept sending the key unencrypted.
# FLIGHT_API_BASE_URL=http://api.aviationstack.com/v1

# --- Email for password reset (any SMTP provider: Brevo, SendGrid, Resend, Gmail app password) ---
# Without EMAIL_HOST, reset emails are only printed to the server console.
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-login
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=Wunderlust <no-reply@yourdomain.com>

# --- Extra hostnames (custom domain), comma-separated. Vercel's own URLs are detected automatically. ---
# EXTRA_ALLOWED_HOSTS=wunderlust.app,www.wunderlust.app

# Optional Frankfurter v1 base URL for expense exchange rates. No key is required.
# FX_API_BASE_URL=https://api.frankfurter.dev/v1
